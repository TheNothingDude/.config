layout {

    focus-ring {
        active-color   "#a45df1"
        inactive-color "#1e0538"
        urgent-color   "#fd4663"
    }

    border {
        active-color   "#a45df1"
        inactive-color "#1e0538"
        urgent-color   "#fd4663"
    }


    tab-indicator {
        active-color   "#a45df1"
        inactive-color "#4b0b91"
        urgent-color   "#fd4663"
    }

    insert-hint {
        color "#a45df180"
    }
}

recent-windows {
    highlight {
        active-color "#a45df1"
        urgent-color "#fd4663"
    }
}
